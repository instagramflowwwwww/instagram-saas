generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String?            @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  accounts         Account[]
  sessions         Session[]
  instagramApp     InstagramApp?
  igAccounts       InstagramAccount[]
  posts            Post[]
  media            MediaLibrary[]
  mediaFolders     MediaFolder[]
  postingBatches   PostingBatch[]
  accessStatus     String             @default("approved")
  planName         String?
  planDurationDays Int?
  accessStartsAt   DateTime?
  accessExpiresAt  DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime           @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InstagramApp {
  id                 String             @id @default(cuid())
  userId             String             @unique
  metaAppId          String
  appSecretEncrypted String
  lastValidatedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts           InstagramAccount[]
}

model InstagramAccount {
  id                String                @id @default(cuid())
  userId            String
  appConfigId       String?
  igUserId          String
  username          String
  name              String?
  accountType       String?
  profilePicture    String?
  accessToken       String?
  instagramUsername String?
  instagramPassword String?
  sessionFilePath   String?
  tokenExpiresAt    DateTime?
  followerCount     Int?
  mediaCount        Int?
  connectionType    String                @default("legacy")
  isActive          Boolean               @default(true)
  proxy             String?
  proxyAssignedAt   DateTime?
  lastActiveAt      DateTime              @default(now())
  createdAt         DateTime              @default(now())
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appConfig         InstagramApp?         @relation(fields: [appConfigId], references: [id], onDelete: SetNull)
  postLogs          PostLog[]
  batchAccounts     PostingBatchAccount[]
  assignedProxy     InstagramProxy?

  @@index([userId, igUserId])
  @@index([appConfigId])
}

model InstagramProxy {
  id                String            @id @default(cuid())
  fingerprint       String            @unique
  encryptedValue    String
  isActive          Boolean           @default(true)
  usedAt            DateTime?
  assignedAt        DateTime?
  assignedAccountId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           InstagramAccount? @relation(fields: [assignedAccountId], references: [id], onDelete: SetNull)

  @@index([isActive, usedAt])
}

model Post {
  id              String            @id @default(cuid())
  userId          String
  videoUrl        String?
  imageUrl        String?
  coverUrl        String?
  publicationType String            @default("post")
  caption         String?
  hashtags        String?
  status          String            @default("draft")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            PostLog[]
  batchItem       PostingBatchItem?
}

model PostLog {
  id                          String           @id @default(cuid())
  postId                      String
  instagramAccountId          String
  status                      String
  errorMessage                String?
  mediaId                     String?
  performancePermalink        String?
  performanceLikeCount        Int?
  performanceCommentsCount    Int?
  performanceViewsCount       Int?
  performanceViewsMetric      String?
  performanceMediaType        String?
  performanceMediaProductType String?
  performancePublishedAt      DateTime?
  performanceUpdatedAt        DateTime?
  performanceError            String?
  createdAt                   DateTime         @default(now())
  post                        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  instagramAccount            InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([instagramAccountId, mediaId])
}

model MediaLibrary {
  id           String             @id @default(cuid())
  userId       String
  folderId     String?
  url          String
  type         String
  fileName     String
  publicId     String?
  resourceType String?
  bytes        Int?
  width        Int?
  height       Int?
  duration     Float?
  format       String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       MediaFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  batchItems   PostingBatchItem[]

  @@index([userId, createdAt])
  @@index([userId, folderId, createdAt])
}

model MediaFolder {
  id        String         @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaLibrary[]

  @@index([userId, name])
  @@index([userId, createdAt])
}

model PostingBatch {
  id              String                @id @default(cuid())
  userId          String
  name            String?
  status          String                @default("scheduled")
  captionMode     String                @default("single")
  publicationType String                @default("post")
  intervalMinutes Int                   @default(10)
  startAt         DateTime
  totalItems      Int                   @default(0)
  processedItems  Int                   @default(0)
  successItems    Int                   @default(0)
  failedItems     Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        PostingBatchAccount[]
  items           PostingBatchItem[]

  @@index([userId, status])
  @@index([status, startAt])
}

model PostingBatchAccount {
  batchId            String
  instagramAccountId String
  batch              PostingBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@id([batchId, instagramAccountId])
  @@index([instagramAccountId])
}

model PostingBatchItem {
  id                  String        @id @default(cuid())
  batchId             String
  mediaId             String?
  postId              String?       @unique
  position            Int
  caption             String?
  hashtags            String?
  scheduledAt         DateTime
  status              String        @default("pending")
  attempts            Int           @default(0)
  lastError           String?
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  batch               PostingBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  media               MediaLibrary? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  post                Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([batchId, position])
  @@index([status, scheduledAt])
  @@index([batchId, status])
}
