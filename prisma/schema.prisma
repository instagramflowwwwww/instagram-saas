generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  accounts          Account[]
  sessions          Session[]
  instagramApps     InstagramApp[]
  igAccounts        InstagramAccount[]
  posts             Post[]
  pushSubscriptions PushSubscription[]
  media             MediaLibrary[]
  mediaFolders      MediaFolder[]
  accountGroups     AccountGroup[]
  postingBatches    PostingBatch[]
  apiTokens         ApiToken[]
  apiConnectionRequests ApiConnectionRequest[]
  storritoConnection StorritoConnection?
  storritoStories   StorritoStory[]
  accessStatus      String             @default("approved")
  planName          String?
  planDurationDays  Int?
  accessStartsAt    DateTime?
  accessExpiresAt   DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime           @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InstagramApp {
  id                 String             @id @default(cuid())
  userId             String
  metaAppId          String
  name               String?
  appSecretEncrypted String
  lastValidatedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts           InstagramAccount[]
  apiConnectionRequests ApiConnectionRequest[]

  @@index([userId])
}

// Token de API próprio do InstaFlow (prefixo "ifk_") para automações externas
// autenticarem via Authorization: Bearer, sem usar cookie/sessão do dashboard.
// Só o hash SHA-256 fica salvo — o valor em texto puro só existe no momento
// da criação, devolvido uma única vez pra quem gerou.
model ApiToken {
  id           String    @id @default(cuid())
  userId       String
  name         String    @default("Token de automação")
  tokenHash    String    @unique
  tokenPreview String
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Registro de uma tentativa de conexão iniciada pela API (/api/v1/connections),
// pra permitir consultar o status depois (pending/connected/failed/expired)
// já que o fluxo OAuth por si só não guarda estado em lugar nenhum.
model ApiConnectionRequest {
  id                 String       @id @default(cuid())
  userId             String
  appConfigId        String
  expectedUsername   String?
  status             String       @default("pending")
  instagramAccountId String?
  connectedUsername  String?
  errorCode          String?
  errorMessage       String?
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  app                InstagramApp @relation(fields: [appConfigId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Integração com o Storrito (serviço de terceiros que posta story com
// adesivo de link, coisa que a API oficial da Meta não permite). A conta do
// Instagram é conectada dentro do próprio Storrito — o InstaFlow só guarda a
// URL base e o token da API dele (cifrado), nunca senha do Instagram.
model StorritoConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  baseUrl        String
  tokenEncrypted String
  // Link de conexão do Storrito (opcional): deixa alguém conectar o Instagram
  // no Storrito sem login lá. Guardado cifrado — quem tem o link consegue
  // conectar contas na organização.
  connectLinkEncrypted String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StorritoStory {
  id                String    @id @default(cuid())
  userId            String
  storyPostUuid     String    @unique
  instagramUsername String
  mediaUrl          String
  linkUrl           String
  linkText          String
  scheduledAt       DateTime?
  status            String    @default("scheduled")
  warnings          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AccountGroup {
  id              String               @id @default(cuid())
  userId          String
  name            String
  color           String?
  // Marca a pasta como sendo de um funcionário que cria contas: cada conta
  // adicionada nela vira um dia de pagamento, calculado em /dashboard/payments.
  isEmployeeGroup Boolean              @default(false)
  payPerAccount   Float                @default(2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  members         AccountGroupMember[]
  paidDays        EmployeePaidDay[]
  employeeLogs    EmployeeAccountLog[]

  @@index([userId])
  @@index([userId, createdAt])
}

// Um dia marcado como "já paguei" pra esse funcionário/pasta — clicado no
// calendário de /dashboard/payments. A existência da linha é o próprio
// estado: existe = pago, não existe = pendente.
model EmployeePaidDay {
  id      String       @id @default(cuid())
  groupId String
  day     String
  paidAt  DateTime     @default(now())
  group   AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, day])
  @@index([groupId])
}

// Registro permanente de "essa conta entrou nessa pasta nesse dia", pra
// pagamento. Guarda o username como retrato do momento em vez de referenciar
// InstagramAccount, então continua contando mesmo se a conta cair e for
// apagada depois — o funcionário já fez o trabalho, o pagamento não some.
model EmployeeAccountLog {
  id       String       @id @default(cuid())
  groupId  String
  username String
  addedAt  DateTime
  group    AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, username, addedAt])
  @@index([groupId])
  @@index([groupId, addedAt])
}

model AccountGroupMember {
  groupId            String
  instagramAccountId String
  createdAt          DateTime         @default(now())
  group              AccountGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@id([groupId, instagramAccountId])
  @@index([instagramAccountId])
}

model InstagramAccount {
  id                String                @id @default(cuid())
  userId            String
  appConfigId       String?
  igUserId          String
  username          String
  name              String?
  accountType       String?
  profilePicture    String?
  accessToken       String?
  instagramUsername String?
  instagramPassword String?
  sessionFilePath   String?
  tokenExpiresAt    DateTime?
  followerCount     Int?
  mediaCount        Int?
  connectionType    String                @default("legacy")
  isActive          Boolean               @default(true)
  proxy             String?
  proxyAssignedAt   DateTime?
  lastActiveAt      DateTime              @default(now())
  profileSyncedAt   DateTime?
  createdAt         DateTime              @default(now())
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appConfig         InstagramApp?         @relation(fields: [appConfigId], references: [id], onDelete: SetNull)
  postLogs          PostLog[]
  batchAccounts     PostingBatchAccount[]
  assignedProxy     InstagramProxy?
  groupMembers      AccountGroupMember[]

  @@index([userId, igUserId])
  @@index([userId, createdAt])
  @@index([userId, connectionType, isActive, tokenExpiresAt])
  @@index([connectionType, isActive, lastActiveAt])
  @@index([connectionType, isActive, profileSyncedAt])
  @@index([appConfigId])
}

model InstagramProxy {
  id                String            @id @default(cuid())
  fingerprint       String            @unique
  encryptedValue    String
  isActive          Boolean           @default(true)
  usedAt            DateTime?
  assignedAt        DateTime?
  assignedAccountId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           InstagramAccount? @relation(fields: [assignedAccountId], references: [id], onDelete: SetNull)

  @@index([isActive, usedAt])
}

model Post {
  id              String            @id @default(cuid())
  userId          String
  videoUrl        String?
  imageUrl        String?
  coverUrl        String?
  publicationType String            @default("post")
  caption         String?
  hashtags        String?
  status          String            @default("draft")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            PostLog[]
  batchItem       PostingBatchItem?

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, status, publishedAt])
  @@index([userId, status, scheduledAt])
}

model PostLog {
  id                          String            @id @default(cuid())
  postId                      String
  instagramAccountId          String?
  // Retrato permanente do @usuário no momento da publicação — sem isso, a
  // performance (views, curtidas, comentários) virava lixo órfão sem dono
  // assim que a conta caísse e fosse apagada; agora sobrevive à conta.
  username                    String?
  status                      String
  errorMessage                String?
  mediaId                     String?
  performancePermalink        String?
  performanceLikeCount        Int?
  performanceCommentsCount    Int?
  performanceViewsCount       Int?
  performanceViewsMetric      String?
  performanceMediaType        String?
  performanceMediaProductType String?
  performancePublishedAt      DateTime?
  performanceUpdatedAt        DateTime?
  performanceError            String?
  // Marca quando o post cruzou a marca de viral e a notificação já foi
  // enviada, para o cron de checagem não avisar duas vezes o mesmo vídeo.
  viralNotifiedAt             DateTime?
  createdAt                   DateTime          @default(now())
  post                        Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  instagramAccount            InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([postId, createdAt])
  @@index([instagramAccountId, mediaId])
  @@index([instagramAccountId, createdAt])
  @@index([username])
}

model MediaLibrary {
  id           String             @id @default(cuid())
  userId       String
  folderId     String?
  url          String
  type         String
  fileName     String
  publicId     String?
  resourceType String?
  bytes        Int?
  width        Int?
  height       Int?
  duration     Float?
  format       String?
  // Legenda salva junto do vídeo/imagem: viaja com a mídia em qualquer
  // automação futura, sem precisar redigitar toda vez que ela é reusada.
  caption      String?
  hashtags     String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       MediaFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  batchItems   PostingBatchItem[]

  @@index([userId, createdAt])
  @@index([userId, folderId, createdAt])
}

model MediaFolder {
  id        String         @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaLibrary[]

  @@index([userId, name])
  @@index([userId, createdAt])
}

model PostingBatch {
  id              String                @id @default(cuid())
  userId          String
  name            String?
  status          String                @default("scheduled")
  captionMode     String                @default("single")
  publicationType String                @default("post")
  intervalMinutes Int                   @default(10)
  startAt         DateTime
  totalItems      Int                   @default(0)
  processedItems  Int                   @default(0)
  successItems    Int                   @default(0)
  failedItems     Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        PostingBatchAccount[]
  items           PostingBatchItem[]

  @@index([userId, status])
  @@index([status, startAt])
}

model PostingBatchAccount {
  batchId            String
  instagramAccountId String
  batch              PostingBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@id([batchId, instagramAccountId])
  @@index([instagramAccountId])
}

model PostingBatchItem {
  id                  String        @id @default(cuid())
  batchId             String
  mediaId             String?
  postId              String?       @unique
  // Quando preenchido, este item publica só nesta conta (modo aleatório por
  // conta). Quando null, publica em todas as contas do lote, como sempre.
  instagramAccountId  String?
  position            Int
  caption             String?
  hashtags            String?
  scheduledAt         DateTime
  status              String        @default("pending")
  attempts            Int           @default(0)
  lastError           String?
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  batch               PostingBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  media               MediaLibrary? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post                Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([batchId, position])
  @@index([status, scheduledAt])
  @@index([batchId, status])
  @@index([instagramAccountId])
}
